# ═══════════════════════════════════════════════════════
# CodeFlow Studio v10.0 — Enterprise Docker Configuration
# ═══════════════════════════════════════════════════════

# Database
POSTGRES_DB=codeflow
POSTGRES_USER=codeflow
POSTGRES_PASSWORD=your_secure_password_here

# Application Port
APP_PORT=80

# AI Provider (gemini | openai | ollama | none)
CODEFLOW_AI_PROVIDER=none
CODEFLOW_AI_API_KEY=
CODEFLOW_AI_MODEL=gemini-2.0-flash
